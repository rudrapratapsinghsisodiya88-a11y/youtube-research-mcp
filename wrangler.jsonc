{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-research-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "YouTubeResearchMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "YouTubeResearchMCP"
      ]
    }
  ]
}
